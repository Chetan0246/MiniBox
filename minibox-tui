#!/usr/bin/env bash
# MiniBox TUI Launcher Script
# Launches the interactive Textual terminal dashboard for MiniBox

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="$SCRIPT_DIR:${PYTHONPATH:-}"

# Check for runtime binary
if [ ! -f "$SCRIPT_DIR/bin/minibox" ]; then
    echo "[minibox-tui] Notice: ./bin/minibox binary not found. Compiling now via make..."
    make -C "$SCRIPT_DIR" all
fi

# Detect Python interpreter
if [ -x "$SCRIPT_DIR/.venv/bin/python3" ]; then
    PYTHON_EXEC="$SCRIPT_DIR/.venv/bin/python3"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON_EXEC="$(command -v python3)"
else
    echo "Error: Python 3 not found on system." >&2
    exit 1
fi

exec "$PYTHON_EXEC" -m tui.app "$@"
